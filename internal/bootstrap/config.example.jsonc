{
  // Default provider, model, and reasoning level.
  // ★ provider is a pointer to a key in the providers map below, not a protocol name.
  //   Changing it requires a matching providers entry, or startup will report missing credentials.
  //   Use /config to manage providers/models and /model to switch among saved models.
  "provider": "openrouter",
  "model": "google/gemini-2.5-flash",
  // Optional. Default reasoning level: off / low / medium / high / xhigh / max.
  // Omitted or empty means no override; use the model/provider default.
  "reasoning_effort": "medium",

  // Provider credential store. Keys are user-defined targets referenced by the provider field above.
  // Known providers (openai/anthropic/gemini/openrouter/deepseek/qwen/glm/grok/mimo/ollama/bedrock)
  // may omit type; custom proxies must declare type explicitly to identify the API protocol.
  "providers": {
    "openrouter": {
      "api_key": "sk-or-v1-xxx",
      "base_url": "https://openrouter.ai/api/v1",
      // Optional. Declare /model candidates and per-model context windows; legacy string arrays remain supported.
      // json_schema explicitly overrides native structured output: true=supported, false=unsupported,
      // omitted=use adapter capability. Explicit values are recommended for custom gateways.
      "models": [
        { "name": "google/gemini-3.0-flash", "context_window": 200000 },
        { "name": "google/gemini-3.1-pro", "context_window": 1000000 }
      ],
      // Optional. Pass extra parameters on every request (sampling parameters such as temperature/top_p/min_p,
      // or vendor-specific keys such as NVIDIA chat_template_kwargs), merged into the request body verbatim.
      // Applies to OpenAI-compatible providers (openrouter/deepseek/qwen/glm/grok/ollama...).
      "extra_body": { "temperature": 0.8, "min_p": 0.05 },
      // Optional provider-level settings passed to the HTTP client (not the request body),
      // for proxies that need custom User-Agent / headers / anthropic_beta.
      "extra": {
        "user_agent": "my-client/1.0",
        "headers": { "X-Custom-Client": "my-client" }
      }
    },
    "anthropic": {
      "api_key": "sk-ant-xxx",
      "models": [{ "name": "claude-sonnet-4-6", "json_schema": true }]
    },
    "ollama": {
      // ollama / bedrock / custom proxies with explicit type may omit api_key.
      // base_url must include /v1 (ollama's OpenAI-compatible endpoint is under /v1).
      "base_url": "http://localhost:11434/v1",
      "models": [{ "name": "qwen3:14b", "context_window": 32768 }],
      // Optional streaming idle watchdog (Go duration, default "5m"). Slow local inference
      // on LocalAI/ollama may need more than five minutes for its first chunk.
      "stream_idle_timeout": "15m"
    },
    "claude-code-proxy": {
      // Custom Anthropic proxy. If the upstream only allows Claude Code clients,
      // use extra to pass user_agent / anthropic_beta / headers. base_url needs no /v1.
      "type": "anthropic",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com",
      "models": [{ "name": "claude-sonnet-4-6", "context_window": 1000000 }],
      "extra": {
        "user_agent": "claude-code/2.1.183",
        "anthropic_beta": "claude-code-20250219",
        "headers": {
          "X-Stainless-Lang": "js",
          "X-Stainless-Package-Version": "0.94.0",
          "X-Stainless-Runtime": "node"
        }
      }
    },
    "codex-proxy": {
      // Custom OpenAI/NewAPI proxy. If the upstream only allows Codex clients,
      // use extra to override User-Agent and pass Codex identification headers.
      // Set base_url to the actual proxy address; OpenAI protocols usually need /v1.
      "type": "openai",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com/v1",
      "models": [
        { "name": "gpt-5.4", "context_window": 400000, "json_schema": true },
        { "name": "gpt-5.4-mini" },
        { "name": "MiniMax-M3", "context_window": 1000000 }
      ],
      // Optional OpenAI endpoint: chat (default /v1/chat/completions) or
      // responses (/v1/responses). Codex-style proxies usually require responses.
      "api": "responses",
      "extra": {
        // Optional. prompt_cache_key is sent by default only to api.openai.com because third-party
        // compatible endpoints have no common contract for unknown fields. Enable this only when
        // the proxy forwards the request body unchanged to OpenAI.
        "prompt_cache_params": true,
        "user_agent": "codex-tui/0.142.3 (Mac OS 26.5.1; arm64) Apple_Terminal/470.2 (codex-tui; 0.142.3)",
        "headers": {
          "Originator": "codex-tui",
          "Session_id": "replace-with-random-session-id",
          "X-Codex-Turn-Metadata": "replace-with-random-turn-metadata"
        }
      }
    }
  },

  // Optional per-role overrides; unconfigured roles use the model above.
  // reasoning_effort can also be overridden per role; otherwise it inherits the top-level value.
  // Roles: architect / writer / editor. fallbacks are tried in order after the primary fails.
  // The provider here is also a pointer and must refer to an existing providers key.
  // "roles": {
  //   "writer": {
  //     "provider": "anthropic",
  //     "model": "claude-sonnet-4",
  //     "reasoning_effort": "high",
  //     "fallbacks": [{ "provider": "openrouter", "model": "google/gemini-3.0-pro" }]
  //   },
  //   "architect": { "provider": "openrouter", "model": "google/gemini-3.1-pro" }
  // },

  // Writing style: default / suspense / fantasy / romance.
  "style": "default"

  // Legacy global context window used as a fallback for all models. Lower priority than
  // models[].context_window but higher than the registry and the 200k default.
  // "context_window": 300000

  // Optional cost budget for one book (output directory), acting as an unattended safety fuse.
  // Enabled only when book_usd > 0. warn_ratio alerts without stopping; 100% stops after the current
  // worker task (hard_stop=true stops immediately). Increase book_usd to resume after stopping.
  // "budget": {
  //   "book_usd": 50,
  //   "warn_ratio": 0.8,
  //   "hard_stop": false
  // },

  // Optional unattended alerts, enabled by default (Windows notifications / macOS osascript / Linux notify-send).
  // With command configured, fields are passed through NOTIFY_TITLE / NOTIFY_BODY / NOTIFY_KIND /
  // NOTIFY_LEVEL environment variables and the complete JSON is also written to stdin.
  // events optionally filters run_end / budget / advance_gate / stop_guard / plan_start / deadlock / worker_failure.
  // "notify": {
  //   "enabled": true,
  //   // Titles and bodies may contain spaces; use --data-urlencode instead of putting them in a URL or header.
  //   // Bark (iOS):         "command": "curl -s --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"body=$NOTIFY_BODY\" https://api.day.app/<key>"
  //   // ntfy (iOS/Android): "command": "curl -s -G --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"message=$NOTIFY_BODY\" ntfy.sh/<topic>/publish"
  //   "events": ["run_end", "budget", "advance_gate", "stop_guard", "plan_start", "deadlock", "worker_failure"]
  // }

  // Optional: true disables startup update reminders (enabled by default). Checks use only the public GitHub Releases
  // API, with results cached locally for 24h. New versions appear on the welcome screen/event stream with release notes.
  // Run ainovel-cli update yourself when you choose to upgrade.
  // "disable_update_check": false
}

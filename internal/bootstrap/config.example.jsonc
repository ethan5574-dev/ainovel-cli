{
  // Default provider and model.
  // ★ provider is a pointer/reference to a key in the providers map below, not a protocol name.
  //   If you change provider, make sure providers contains a matching entry or startup will fail with "missing credentials".
  //   Switching models in the /model panel at runtime does not write back here automatically.
  "provider": "openrouter",
  "model": "google/gemini-2.5-flash",

  // Provider credential store. Keys are user-defined and referenced by the provider field above.
  // Known providers (openai/anthropic/gemini/openrouter/deepseek/qwen/glm/grok/mimo/ollama/bedrock)
  // may omit type; custom proxies must declare type explicitly.
  "providers": {
    "openrouter": {
      "api_key": "sk-or-v1-xxx",
      "base_url": "https://openrouter.ai/api/v1",
      // Optional. Declare /model panel candidates; if omitted, fall back to models already seen for this provider.
      "models": ["google/gemini-3.0-flash", "google/gemini-3.1-pro"],
      // Optional. Pass through extra request parameters (sampling parameters like temperature/top_p/min_p,
      // or vendor-specific keys such as NVIDIA chat_template_kwargs) directly into the request body.
      // Only applies to OpenAI-compatible providers; type:"openai" will filter by the official parameter whitelist.
      "extra_body": { "temperature": 0.8, "min_p": 0.05 },
      // Optional. Provider-level configuration passed to the HTTP client layer, not the request body.
      "extra": {
        "user_agent": "my-client/1.0",
        "headers": { "X-Custom-Client": "my-client" }
      }
    },
    "anthropic": {
      "api_key": "sk-ant-xxx",
      "models": ["claude-sonnet-4", "claude-opus-4"]
    },
    "ollama": {
      // ollama / bedrock / custom proxies with explicit type can omit api_key
      // base_url must include /v1 (Ollama's OpenAI-compatible endpoint is under /v1)
      "base_url": "http://localhost:11434/v1",
      "models": ["qwen3:14b"]
    },
    "my-proxy": {
      // Custom Anthropic proxy. Use extra to pass user_agent / anthropic_beta / headers when the proxy needs client identification.
      "type": "anthropic",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com",
      "models": ["claude-sonnet-4-6"],
      "extra": {
        "user_agent": "claude-code/2.1.183",
        "anthropic_beta": "claude-code-20250219",
        "headers": {
          "X-Stainless-Lang": "js",
          "X-Stainless-Package-Version": "0.94.0",
          "X-Stainless-Runtime": "node"
        }
      }
    }
  },

  // Optional. Override the default model per role; unconfigured roles use the model above.
  // Roles: coordinator / architect / writer / editor. fallbacks are tried in order if the main model fails.
  // Note: provider here is also a key reference and must point to an existing providers entry.
  // "roles": {
  //   "writer": {
  //     "provider": "anthropic",
  //     "model": "claude-sonnet-4",
  //     "fallbacks": [{ "provider": "openrouter", "model": "google/gemini-3.0-pro" }]
  //   },
  //   "architect": { "provider": "openrouter", "model": "google/gemini-3.1-pro" }
  // },

  // Writing style: default / suspense / fantasy / romance.
  "style": "default"

  // Optional. Explicitly set the window size used for context compaction. Omit / 0 to resolve from the model name
  // (registered models use their real window, unknown ones fall back to 200k). When set, it takes priority.
  // "context_window": 300000

  // Optional. Cost budget for a single book (the output directory). Enabled when book_usd > 0.
  // At warn_ratio the run warns but keeps going; at 100% it stops after the current subagent task completes
  // (hard_stop=true stops immediately once the limit is crossed).
  // "budget": {
  //   "book_usd": 50,
  //   "warn_ratio": 0.8,
  //   "hard_stop": false
  // },

  // Optional. Unattended alerts, enabled by default (macOS osascript / Linux notify-send desktop notifications).
  // If command is set, alerts go through a custom command instead.
  // Passed via $NOTIFY_TITLE / $NOTIFY_BODY / $NOTIFY_KIND / $NOTIFY_LEVEL; the full JSON is also written to stdin.
  // events can be filtered: run_end (complete/stop) / repeat (repeated instruction, likely a stall) / budget (budget).
  // "notify": {
  //   "enabled": true,
  //   // If the title/body contains spaces or non-ASCII text, pass them via --data-urlencode instead of stuffing them into the URL path or HTTP headers.
  //   // Bark (iOS):         "command": "curl -s --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"body=$NOTIFY_BODY\" https://api.day.app/<key>"
  //   // ntfy (iOS/Android): "command": "curl -s -G --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"message=$NOTIFY_BODY\" ntfy.sh/<topic>/publish"
  //   "events": ["run_end", "repeat", "budget"]
  // }
}
